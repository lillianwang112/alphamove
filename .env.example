# Firebase — get from Firebase Console → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Finnhub — get from finnhub.io/register (free, instant)
VITE_FINNHUB_API_KEY=

# Anthropic Claude API — from hackathon sponsor credits
VITE_ANTHROPIC_API_KEY=

# Puter fallback (no key needed — uses puter.ai.chat() directly)
# Just set VITE_USE_PUTER=true if Anthropic credits don't come through
VITE_USE_PUTER=false
